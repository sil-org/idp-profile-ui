#
# Used by Playwright (`vite build --mode e2e`). Values here take priority over .env.local so every
# machine builds the same UI. The API is mocked in e2e/mocks/api.js at the same origin.
#
VITE_API_BASE_URL=/api
VITE_PRIMARY_COLOR='#015d99'
VITE_SECONDARY_COLOR='#791f5e'
VITE_ERROR_COLOR='#D52227'
VITE_SUCCESS_COLOR='#509E2F'
VITE_ORANGE='#FF6B00'
VITE_ANALYTICS_ID='G-E2E0000000'
VITE_RECAPTCHA_ID='e2e-site-key'
VITE_SENTRY_DSN=
VITE_PROJECT_NAME=idp-profile-ui-e2e
VITE_TOTP_APP_RECOMMENDATION=authenticator
UI_VERSION=e2e
